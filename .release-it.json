{
	"git": {
		"pushRepo": "origin",
		"tagName": "v${version}",
		"push": true,
		"commitMessage": "chore: release v${version}"
	},
	"github": {
		"release": true,
		"releaseName": "v${version}",
		"skipChecks": true
	},
	"npm": {
		"publish": true
	},
	"plugins": {
		"@release-it/conventional-changelog": {
			"infile": "CHANGELOG.md",
			"preset": {
				"name": "conventionalcommits"
			}
		}
	},
	"hooks": {
		"before:init": ["npm run typecheck", "npm run test"],
		"after:bump": "npm run build"
	}
}
