{
	"git": {
		"pushRepo": "origin",
		"tagName": "v${version}",
		"push": true
	},
	"github": {
		"release": false
	},
	"npm": {
		"publish": true
	},
	"plugins": {
		"@release-it/conventional-changelog": {
			"infile": "CHANGELOG.md",
			"preset": {
				"name": "conventionalcommits"
			}
		}
	},
	"hooks": {
		"before:init": ["npm run typecheck", "npm run test"],
		"after:bump": "npm run build",
		"after:release": "gh release create v${version} --title \"v${version}\" --notes \"$(cat CHANGELOG.md)\""
	}
}
